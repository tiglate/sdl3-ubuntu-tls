# One source package, twelve binaries. The libraries here have to be built in
# dependency order against each other (plutosvg and SDL3 first, then the
# satellites, SDL3_ttf last), and a Launchpad build only sees binaries the PPA
# has already *published* -- roughly twenty minutes behind the build that
# produced them. Six separate source packages would therefore need ordered
# uploads and dependency-wait retries to converge. Vendoring the six upstream
# trees into one source package builds the whole chain in a single chroot,
# exactly as make.sh does locally, and the ordering problem stops existing.
Source: sdl3-stack
Section: libs
Priority: optional
Maintainer: Tiglate Pileser III <tiglate@fastmail.com>
Build-Depends:
 debhelper-compat (= 13),
 cmake,
 ninja-build,
 git,
 pkg-config,
 libasound2-dev,
 libpulse-dev,
 libpipewire-0.3-dev,
 libjack-jackd2-dev,
 libsndio-dev,
 libx11-dev,
 libxext-dev,
 libxrandr-dev,
 libxcursor-dev,
 libxfixes-dev,
 libxi-dev,
 libxss-dev,
 libxkbcommon-dev,
 libxtst-dev,
 libxrender-dev,
 x11proto-dev,
 libwayland-dev,
 wayland-protocols,
 libdecor-0-dev,
 libdrm-dev,
 libgbm-dev,
 libgl-dev,
 libgles-dev,
 libegl-dev,
 libvulkan-dev,
