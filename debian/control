Package: libsdl3-0
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
Description: Simple DirectMedia Layer 3 (shared library)
 SDL is a cross-platform library for low-level access to audio, keyboard,
 mouse, joystick and graphics hardware.
 .
 This package contains the shared library.

Package: libsdl3-dev
Section: libdevel
Architecture: any
Depends: libsdl3-0 (= ${binary:Version}), ${misc:Depends}
Description: Simple DirectMedia Layer 3 (development files)
 SDL is a cross-platform library for low-level access to audio, keyboard,
 mouse, joystick and graphics hardware.
 .
 This package contains the headers, the static library, pkg-config and CMake
 files needed to build against it.

Package: libsdl3-image0
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
# Was libsdl3-image-0 before this was published to a PPA, which is not the name
# Debian and Ubuntu use for this SONAME. Anyone who installed the .deb files
# from a GitHub release has the old name, and both packages ship the same
# files, so an upgrade needs these two to replace it rather than collide.
Conflicts: libsdl3-image-0
Replaces: libsdl3-image-0
Description: SDL3_image image loading library (shared library)
 SDL3_image is an add-on for SDL 3 that loads images as SDL surfaces and
 textures: PNG, JPEG, WebP, AVIF, JPEG XL, TIFF, SVG and more.
 .
 Codecs are loaded on demand at run time, so support for a given format also
 depends on its shared library being present.
 .
 This package contains the shared library.

Package: libsdl3-image-dev
Section: libdevel
Architecture: any
Depends: libsdl3-image0 (= ${binary:Version}), libsdl3-dev, ${misc:Depends}
Description: SDL3_image image loading library (development files)
 SDL3_image is an add-on for SDL 3 that loads images as SDL surfaces and
 textures: PNG, JPEG, WebP, AVIF, JPEG XL, TIFF, SVG and more.
 .
 This package contains the headers, pkg-config and CMake files needed to build
 against it.

Package: libsdl3-mixer0
Architecture: any
Multi-Arch: same
Depends: ${shlibs:Depends}, ${misc:Depends}
# Was libsdl3-mixer-0 before this was published to a PPA, which is not the name
# Debian and Ubuntu use for this SONAME. Anyone who installed the .deb files
# from a GitHub release has the old name, and both packages ship the same
# files, so an upgrade needs these two to replace it rather than collide.
Conflicts: libsdl3-mixer-0
Replaces: libsdl3-mixer-0
Description: SDL3_mixer audio mixer library (shared library)
 SDL3_mixer is an add-on for SDL 3 that mixes and decodes audio: WAV, FLAC,
 MP3, Ogg Vorbis, Opus, MOD and MIDI.
 .
 Codecs are loaded on demand at run time, so support for a given format also
 depends on its shared library being present.
 .
 This package contains the shared library.

Package: libsdl3-mixer-dev
Section: libdevel
Architecture: any
# ${shlibs:Depends}, unlike the other -dev packages, because this one ships
# upstream's installed example programs under /usr/libexec and those are ELF
# binaries linking libSDL3_mixer and libSDL3.
Depends: libsdl3-mixer0 (= ${binary:Version}), libsdl3-dev, ${shlibs:Depends},
 ${misc:Depends}
Description: SDL3_mixer audio mixer library (development files)
 SDL3_mixer is an add-on for SDL 3 that mixes and decodes audio: WAV, FLAC,
 MP3, Ogg Vorbis, Opus, MOD and MIDI.
 .
 This package contains the headers, pkg-config and CMake files needed to build
 against it, and the installed example programs.

